#!/bin/sh
# Managed by Ansible — do not edit manually
# Role: immich | Template: immich-backup.sh.j2
set -eu

BACKUP_DIR="{{ immich_backup_dir }}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="${BACKUP_DIR}/immich_db_${TIMESTAMP}.sql.gz"

{{ immich_docker_bin }} exec -t immich_postgres \
    pg_dumpall --clean --if-exists \
    --username="{{ immich_db_username }}" \
    | gzip > "${BACKUP_FILE}"

find "${BACKUP_DIR}" -name "immich_db_*.sql.gz" -mtime +{{ immich_backup_keep_days }} -delete

echo "$(date '+%Y-%m-%d %H:%M:%S') Backup OK: ${BACKUP_FILE}"
